#!/bin/bash
set -euo pipefail

if [ "${wizard_data_action:-keep}" != "delete" ]; then
  echo "保留应用数据以便重新安装。"
  exit 0
fi

for directory in "${TRIM_PKGVAR:-}" "${TRIM_PKGHOME:-}"; do
  [ -n "$directory" ] && [ -d "$directory" ] || continue
  rm -rf "$directory"/* "$directory"/.[!.]* "$directory"/..?* 2>/dev/null || true
  if [ -n "$(ls -A "$directory" 2>/dev/null)" ]; then
    echo "应用数据未能完全删除: $directory" >&2
    exit 1
  fi
done
